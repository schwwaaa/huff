digraph G { graph [rankdir=LR,bgcolor="transparent",pad=.2,nodesep=.3,ranksep=.55]; node [shape=box,style="filled",fontname="Courier",fontsize=11,color="#404040",fillcolor="#d4d0c8"]; edge [color="#b61718",penwidth=1.5,fontname="Courier",fontsize=9]; feature [label="NEW FEATURE\nshader / store / keyer / source"]; declare [label="DECLARE CONTRACT\ninputs · output · persistence\nparameters · resource budget"]; engine [label="IMPLEMENT + VALIDATE\nGPU ownership · synchronization\nlegal insertion points"]; schema [label="ROUTING SCHEMA\nexpose only legal choices"]; recipes [label="RECIPE FAMILIES\nnamed reusable pipelines",fillcolor="#000000",fontcolor="#00ff00"]; feature->declare->engine->schema->recipes; }