digraph G { graph [rankdir=LR,bgcolor="transparent",pad=.2,nodesep=.3,ranksep=.6]; node [shape=box,style="filled",fontname="Courier",fontsize=11,color="#404040",fillcolor="#d4d0c8"]; edge [color="#b61718",penwidth=1.5,fontname="Courier",fontsize=9]; symptom [label="SYMPTOM\nstall · missing output · error"]; verify [label="VERIFY REPORT\nPASS · WARNING · FAIL · INFO",fillcolor="#000000",fontcolor="#00ff00"]; surface [label="RECOVER SURFACE"]; source [label="RESTART SOURCE"]; outputs [label="RESTART OUTPUTS"]; all [label="RECOVER ALL"]; preserve [label="PRESERVE CREATIVE STATE\nparameters · routing · mappings · projects"]; diag [label="EXPORT DIAGNOSTICS"]; symptom->verify; verify->surface [label="surface/GPU"]; verify->source [label="decode/camera/audio"]; verify->outputs [label="Syphon/Spout"]; verify->all [label="combined"]; surface->preserve; source->preserve; outputs->preserve; all->preserve; verify->diag; }