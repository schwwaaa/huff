digraph G { graph [rankdir=LR,bgcolor="transparent",pad=.2,nodesep=.3,ranksep=.65]; node [shape=box,style="filled",fontname="Courier",fontsize=11,color="#404040",fillcolor="#d4d0c8"]; edge [color="#b61718",penwidth=1.5,fontname="Courier",fontsize=9]; clean [label="CLEAN FRAME"]; history [label="HISTORY RING\nrecent immutable-at-render frames",fillcolor="#fff4b0"]; policy [label="UPDATE POLICY\nlive · hold · capture · sample\ntrail · scan · catch-up · feedback"]; store [label="FIELD / TRAIL / FEEDBACK STORE\npersistent writable image",fillcolor="#fff4b0"]; mask [label="WRITE / PROTECT / DISPLAY MASK"]; process [label="PROCESS + COMPOSITE"]; out [label="PROGRAM",fillcolor="#000000",fontcolor="#00ff00"]; clean->history; clean->policy; history->process; policy->store; mask->policy; store->process; clean->process; process->out; }