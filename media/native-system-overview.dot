digraph G { graph [rankdir=LR,bgcolor="transparent",pad=.2,nodesep=.35,ranksep=.6]; node [shape=box,style="filled",fontname="Courier",fontsize=11,color="#404040",fillcolor="#d4d0c8"]; edge [color="#b61718",penwidth=1.6,fontname="Courier",fontsize=9]; ui [label="HTML CONTROL SURFACE\nsliders · actions · overlays"]; state [label="CANONICAL RUST STATE\n100 parameters · actions · scopes"]; media [label="NATIVE MEDIA OWNERSHIP\nvideo · camera · audio · transport"]; gpu [label="WGPU RENDER ENGINE\nhistory · field store · effects"]; program [label="PROGRAM\nauthoritative RGBA output",fillcolor="#000000",fontcolor="#00ff00"]; monitor [label="MONITOR\nlocal native window"]; rec [label="LIVE RECORDING"]; export [label="STILL / OFFLINE EXPORT"]; interop [label="SYPHON / SPOUT"]; controls [label="MIDI · OSC · PRESETS\nAUTOMATION · PROJECTS"]; ui->state; controls->state; state->media; state->gpu; media->gpu; gpu->program; program->monitor; program->rec; program->export; program->interop; }