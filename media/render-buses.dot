digraph G { graph [rankdir=LR,bgcolor="transparent",pad=.2,nodesep=.32,ranksep=.7]; node [shape=box,style="filled",fontname="Courier",fontsize=11,color="#404040",fillcolor="#d4d0c8"]; edge [color="#b61718",penwidth=1.5,fontname="Courier",fontsize=9]; clean [label="CLEAN\ncurrent normalized source"]; history [label="HISTORY\nbounded recent frames",fillcolor="#fff4b0"]; process [label="PROCESS\nglitch · scan · smoosh\nluma · mix · flow · feedback"]; store [label="FIELD STORE\npersistent flying image",fillcolor="#fff4b0"]; mask [label="MASK\nluminance region control"]; program [label="PROGRAM\ncommitted output",fillcolor="#000000",fontcolor="#00ff00"]; monitor [label="MONITOR\nlocal inspection"]; clean->history [label="capture"]; clean->process [label="current frame"]; history->process [label="historical samples"]; process->store [label="write/update"]; store->process [label="1-frame temporal return"]; mask->process [label="restore/reveal"]; process->program; clean->program [style=dashed,label="bypass option"]; store->program [style=dashed,label="raw option"]; program->monitor; clean->monitor [style=dashed]; store->monitor [style=dashed]; }