{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "huff",
    "version": "1.0.3"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "huff \u00b7 canvas",
        "url": "canvas.html",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "controls",
        "title": "huff \u00b7 controls",
        "url": "index.html",
        "width": 800,
        "height": 1200,
        "resizable": true,
        "decorations": true
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.schwwaaa.huff",
      "publisher": "schwwaaa",
      "category": "Video",
      "shortDescription": "A real-time audiovisual feedback and video-processing instrument.",
      "longDescription": "HUFF Classic is a focused real-time video instrument for feedback, corruption, scanline, temporal, MIDI, OSC, Syphon, and Spout performance workflows.",
      "copyright": "Copyright \u00a9 2026 schwwaaa",
      "icon": [
        "icons/icon.icns",
        "icons/icon.png",
        "icons/icon.ico"
      ],
      "macOS": {
        "entitlements": "src-tauri/entitlements.plist",
        "frameworks": [
          "frameworks/Syphon.framework"
        ],
        "minimumSystemVersion": "10.15"
      }
    },
    "allowlist": {
      "dialog": {
        "open": true,
        "save": true
      }
    }
  }
}
