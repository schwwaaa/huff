{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huff Native",
  "version": "0.16.0",
  "identifier": "com.schwwaaa.huff.native.wgpu",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "huff \u00b7 native wgpu",
        "url": "index.html",
        "width": 1280,
        "height": 940,
        "minWidth": 720,
        "minHeight": 680,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [
        "frameworks/Syphon.framework"
      ]
    }
  }
}
