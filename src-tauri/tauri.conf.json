{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "huff",
    "version": "1.0.2"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "huff \u00b7 canvas",
        "url": "canvas.html",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "controls",
        "title": "huff \u00b7 controls",
        "url": "index.html",
        "width": 800,
        "height": 1200,
        "resizable": true,
        "decorations": true
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.example.huff",
      "icon": [
        "icons/icon.icns",
        "icons/icon.png",
        "icons/icon.ico"
      ],
      "macOS": {
        "entitlements": "src-tauri/entitlements.plist",
        "frameworks": [
          "frameworks/Syphon.framework"
        ]
      }
    }
  }
}
