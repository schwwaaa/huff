{
  "$schema": "https://schema.tauri.app/config/1",

  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },

  "package": {
    "productName": "huff",
    "version": "0.1.0"
  },

  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "win",
        "url": "canvas.html",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "controls",
        "title": "ctrl",
        "url": "controls.html",
        "width": 800,
        "height": 1200,
        "resizable": true,
        "decorations": true
      }
    ],

    "bundle": {
      "active": true,
      "identifier": "com.example.huff",
      "icon": [
        "icons/icon.icns",
        "icons/icon.png",
        "icons/icon.ico"
      ],
      "macOS": {
        "entitlements": "src-tauri/entitlements.plist"
      }
    }
  }
}