digraph G { graph [rankdir=LR,bgcolor="transparent",pad=.2,nodesep=.3,ranksep=.65]; node [shape=box,style="filled",fontname="Courier",fontsize=11,color="#404040",fillcolor="#d4d0c8"]; edge [color="#b61718",penwidth=1.5,fontname="Courier",fontsize=9]; live [label="RUNNING PROGRAM\nwall-clock performance",fillcolor="#000000",fontcolor="#00ff00"]; cfr [label="CFR RECORDER\n30 / 60 FPS\nrepeat latest frame if late"]; still [label="STILL EXPORT\none selected Program frame"]; fixed [label="PRIVATE FIXED TIMELINE\nexact source frame + state"]; export_graph [label="PRIVATE EXPORT GRAPH\nrequested resolution"]; enc [label="H.264 · PRORES · FFV1\nPNG SEQUENCE"]; live->cfr; live->still; fixed->export_graph; export_graph->enc; }