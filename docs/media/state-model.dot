digraph G { graph [rankdir=TB,bgcolor="transparent",pad=.2,nodesep=.35,ranksep=.45]; node [shape=box,style="filled",fontname="Courier",fontsize=11,color="#404040",fillcolor="#d4d0c8"]; edge [color="#b61718",penwidth=1.4,fontname="Courier",fontsize=9]; registry [label="CANONICAL STATE\nparameters · actions · mappings · routes",fillcolor="#000000",fontcolor="#00ff00"]; preset [label="PRESET\nscoped artistic condition"]; snap [label="SNAPSHOT\nbroad machine-state capture"]; seq [label="SEQUENCE\ntimed events + interpolation"]; proj [label="PROJECT\nstate + source refs + automation + maps"]; scopes [label="RECALL SCOPES\nLook · Source · Temporal · Routing\nRender · Transport · Automation · Maps"]; pixels [label="PERSISTENT GPU PIXELS\nidentified but not embedded by default",fillcolor="#fff4b0"]; registry->preset; registry->snap; registry->seq; registry->proj; scopes->preset [dir=both]; scopes->snap [dir=both]; scopes->proj [dir=both]; pixels->snap [style=dashed,label="explicit/limited"]; pixels->proj [style=dashed,label="not automatic"]; }